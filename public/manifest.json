{
  "manifest_version": 3,
  "name": "VierCRM",
  "version": "0.3.0",
  "description": "Airtable-style CRM: scrape any list or Google Maps search into bases (people, companies, places, researchers), find publications automatically, automate e-mail.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "VierCRM – open side panel", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "scripting", "activeTab", "tabs", "alarms", "identity", "downloads"],
  "host_permissions": [
    "https://api.openalex.org/*", "https://api.crossref.org/*", "https://api.semanticscholar.org/*", "https://eutils.ncbi.nlm.nih.gov/*",
    "https://api.unpaywall.org/*", "https://www.ebi.ac.uk/*", "https://api.brevo.com/*", "https://gmail.googleapis.com/*", "https://www.googleapis.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "web_accessible_resources": [],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
