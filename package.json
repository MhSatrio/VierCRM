{
  "name": "viercrm",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "VierCRM – Airtable-style CRM, researcher scraper, publication research and e-mail automation (Chrome MV3 extension)",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "build": "vite build && vite build --config vite.content.config.ts && node scripts/finish-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node tests/e2e/run.mjs",
    "bench": "node tests/perf/bench.mjs",
    "docs": "node scripts/build-docs.mjs",
    "webhook": "node backend/webhook-server.mjs"
  },
  "dependencies": {
    "@fontsource/jost": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "docx": "^9.15.2",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
